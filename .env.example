# ==============================================================================
# AegisRAG - Enterprise Agentic RAG Configuration (.env.example)
# ==============================================================================

# --- PRIMARY LLM & GATEWAY (Portkey + Groq) ---
PORTKEY_API_KEY=pk-portkey-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_FALLBACK_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JUDGE_GROQ=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- VECTOR DATABASE (Qdrant Cloud or Local) ---
QDRANT_CLUSTER_ENDPOINT=https://xxxxxx.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=thIs-Is-Y0uR-Qdr4nt-Cl0ud-AP1-K3y
# QDRANT_URL=http://localhost:6333

# --- EMBEDDINGS (Gemini Preview 3072-dim) ---
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- OBSERVABILITY & TRACING ---
LOGFIRE_TOKEN=your_logfire_token_here
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGSMITH_PROJECT=rag_scale_test
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- OPTIONAL PLATFORM FEATURES ---
CHECKPOINTER_TYPE=memory          # "memory" or "sqlite"
SQLITE_DB_PATH=state_checkpoint.db
FEEDBACK_DB_PATH=feedback.db
ENABLE_HYBRID_SEARCH=false        # true to enable BM25 + Vector fusion
MAX_CONTEXT_CHARS=8000            # Cap on context sent to Groq
AEGIS_API_KEY=                    # Optional API Key for securing endpoints
RATE_LIMIT_PER_MINUTE=60